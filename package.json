{
  "name": "ai-video-canvas",
  "version": "0.1.1",
  "description": "AI Video Creation Canvas - Desktop application for AI-powered video creation workflow",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:portable": "vite build && electron-builder --win portable",
    "electron:build:installer": "vite build && electron-builder --win nsis",
    "electron:build:dir": "vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.sanshiman.aivideo-canvas",
    "productName": "AI Video Canvas",
    "publish": {
      "provider": "github"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs",
      "type": "commonjs"
    },
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Video Canvas",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AI-Video-Canvas-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "AI-Video-Canvas-${version}-portable.exe"
    }
  },
  "keywords": [
    "electron",
    "vue",
    "ai",
    "video",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@tresjs/core": "^3.9.0",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.33.0",
    "@vue-flow/minimap": "^1.4.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.0",
    "three": "^0.161.0",
    "vue": "^3.4.0",
    "vue-grid-layout": "^2.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0",
    "wait-on": "^7.2.0"
  }
}
